{
  "name": "@inventec/dsh-copilot-auth",
  "version": "1.4.1-local.1",
  "description": "GitHub Copilot 本地升级版：设备码登录、实时账号能力驱动的新模型目录、只增预览同步与未解析原因、chat: 兼容、全目录及定制保护。基于上游 1.2.26，静态 pi-ai 1.5.2 之外受限接入 GPT-6.2 Sol / Gemini 4 Carbon / MAI Code 2 / MAI Code 2 Flash；权限与推理仍受账号及宿主协议限制。",
  "icon": "./icon.svg",
  "type": "module",
  "license": "MIT",
  "author": "iasi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iasiv5/dsh-copilot-auth.git"
  },
  "main": "./src/host.mjs",
  "exports": {
    ".": "./src/host.mjs",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "src/host.mjs",
    "src/shared.mjs",
    "lib/client.js",
    "cordis.patch.yml",
    "locale",
    "README.md",
    "docs/CHANGELOG.md",
    "docs/assets",
    "LICENSE",
    "src/catalog.mjs",
    "src/catalog-registry.mjs",
    "src/catalog-fetch.mjs",
    "src/copilot-models.mjs",
    "src/live-catalog.mjs",
    "src/atomic-json.mjs",
    "src/state.mjs",
    "src/refresh-flow.mjs",
    "src/client-http.mjs",
    "src/runtime-scope.mjs",
    "src/auth-host.mjs",
    "src/auth-flow.mjs",
    "src/model-update.mjs",
    "src/refresh-service.mjs",
    "src/refresh-transaction.mjs",
    "src/catalog-overlay.json",
    "src/supplement-models.mjs",
    "src/model-tool.mjs",
    "docs/LOCAL-UPGRADE.md",
    "icon.svg"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node --test",
    "prepack": "npm run build",
    "capture": "node scripts/capture-previews.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "playwright-core": "1.62.1",
    "react": "^18.2.0",
    "yaml": "^2.5.0"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.7-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  }
}
